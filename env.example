# Copy this file to .env and adjust the values.

# Copy this file to .env and set a real connection string.
# Local MongoDB:
MONGODB_URI=mongodb:cluster0/local.oplog.rs

# MongoDB Atlas (cloud) looks like this instead:
# MONGODB_URI=mongodb+srv://vallavans562_db_user:<1234>@cluster0.tmgrfhg.mongodb.net/

PORT=3000

# Current Skill Demand automation
# Bing Web Search API (or another compatible approved search service endpoint)
JOB_SEARCH_API_KEY=
JOB_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
JOB_SEARCH_QUERY=latest software developer job postings required skills India
JOB_SEARCH_MAX_RESULTS=25
# OpenAI-compatible chat-completions endpoint
AI_API_KEY=
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Required to call POST /api/skill-demand/refresh manually
DEMAND_REFRESH_TOKEN=
# Set true to run one refresh when the server connects, then every 24 hours
RUN_DEMAND_REFRESH_ON_START=false
